# Rust / Cargo
/target/

# rustfmt 生成的备份文件
**/*.rs.bk

# MSVC Windows 调试符号
*.pdb

# rustc 内部错误生成的崩溃转储
rustc-ice-*.txt

# cargo-mutants 生成的测试产物；未使用 cargo-mutants 时可不加
**/mutants.out*/

# 本地环境变量和密钥
.env
.env.*
!.env.example

# 覆盖率 / profiling 产物
*.profraw
*.profdata
/coverage/

# 操作系统和编辑器临时文件
.DS_Store
*.swp
*.swo

/docs/bittorrent.org
